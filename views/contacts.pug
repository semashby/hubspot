doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    title Contacts | Reference
    link(rel="stylesheet" href="/css/style.css")
  body
    h1 Contacts (Reference Template)
    p This template is provided for reference only.

    if contacts && contacts.length
      table
        thead
          tr
            th First Name
            th Last Name
            th Email
        tbody
          each contact in contacts
            tr
              td= contact.properties.firstname || '—'
              td= contact.properties.lastname || '—'
              td= contact.properties.email || '—'
    else
      p No contacts found.
